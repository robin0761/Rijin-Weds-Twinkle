---
import '../styles/global.css';

const churchMap = 'https://www.google.com/maps/dir/?api=1&destination=23.154402911396627%2C79.96616507482811';
const receptionMap = 'https://www.google.com/maps/dir/?api=1&destination=23.123976812537265%2C79.96574097482726';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f8fb" />
    <meta name="description" content="Join us to celebrate the wedding of Rijin and Twinkle on Thursday, November 12, 2026, in Jabalpur." />
    <title>Rijin &amp; Twinkle | Wedding Invitation</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="topbar">
      <a class="wordmark" href="#home" aria-label="Rijin and Twinkle wedding invitation">R<span>&amp;</span>T</a>
      <nav aria-label="Invitation sections">
        <a href="#celebration">The celebration</a>
        <a href="#venues">Find us</a>
      </nav>
      <button class="music-toggle" type="button" aria-pressed="false" aria-label="Play wedding music">
        <span class="sound-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="music-label">Play music</span>
      </button>
      <audio id="wedding-music" preload="none" loop>
        <source src="/media/wedding-music.mp3" type="audio/mpeg" />
      </audio>
    </header>

    <main>
      <section class="hero" id="home" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> A day to remember <span></span></p>
          <h1 id="hero-title">Rijin <em>&amp;</em><br />Twinkle</h1>
          <p class="hero-note">With joyful hearts, we invite you to celebrate our wedding.</p>
          <a class="text-link" href="#celebration">Join us on our day <span aria-hidden="true">↓</span></a>
        </div>
        <figure class="hero-photo">
          <img src="/images/wedding-card-art.webp" alt="Illustrated wedding invitation artwork featuring Rijin and Twinkle" fetchpriority="high" />
          <figcaption>Rijin &amp; Twinkle · Jabalpur</figcaption>
        </figure>
        <div class="hero-date" aria-label="Thursday, November 12, 2026">
          <span>THU</span><strong>12</strong><span>NOV · 2026</span>
        </div>
      </section>

      <section class="moments" aria-labelledby="moments-title">
        <div class="moments-heading">
          <p class="eyebrow">A little glimpse of us</p>
          <h2 id="moments-title">The moments in between</h2>
        </div>
        <div class="photo-row">
          <figure class="moment moment-one">
            <img src="/images/couple-real.webp" alt="Rijin and Twinkle smiling together" loading="lazy" />
            <figcaption>Side by side</figcaption>
          </figure>
          <figure class="moment moment-two">
            <img src="/images/photo-2.webp" alt="A relaxed moment together at a garden cafe" loading="lazy" />
            <figcaption>Somewhere sunny</figcaption>
          </figure>
          <figure class="moment moment-three">
            <img src="/images/photo-3.webp" alt="Twinkle and Rijin sharing a quiet moment" loading="lazy" />
            <figcaption>Always us</figcaption>
          </figure>
        </div>
      </section>

      <section class="invitation" id="celebration" aria-labelledby="invitation-title">
        <p class="eyebrow">Together with our families</p>
        <h2 id="invitation-title">A celebration of love</h2>
        <p class="invitation-copy">Please join us as we begin a new chapter, surrounded by the people we love.</p>
        <div class="event-grid" id="venues">
          <article class="event ceremony">
            <p class="event-index">01 <span>·</span> THE WEDDING</p>
            <h3>Wedding ceremony</h3>
            <p class="event-time">Thursday, November 12 <span>2026</span></p>
              <p class="event-hour">3:30 <span>PM</span></p>
            <p class="event-place">St. Andrews Mar Thoma Church<br />Ridge Road, Jabalpur</p>
            <a class="direction-link" href={churchMap} target="_blank" rel="noreferrer">Get directions <span aria-hidden="true">↗</span></a>
          </article>
          <article class="event reception">
            <p class="event-index">02 <span>·</span> THE RECEPTION</p>
            <h3>An evening together</h3>
            <p class="event-time">Thursday, November 12 <span>2026</span></p>
            <p class="event-hour">7:30 <span>PM onwards</span></p>
            <p class="event-place">Vijan Mahal · Pool Side Lawn<br />Tilhari Manda Road, Jabalpur</p>
            <a class="direction-link" href={receptionMap} target="_blank" rel="noreferrer">Get directions <span aria-hidden="true">↗</span></a>
          </article>
        </div>
      </section>

      <section class="closing" aria-label="A note from the couple">
        <p class="eyebrow">We can’t wait to celebrate with you</p>
        <p class="closing-names">Rijin <span>&amp;</span> Twinkle</p>
        <p class="closing-date">NOVEMBER 12, 2026 · JABALPUR</p>
      </section>
    </main>

    <footer>
      <span>Made with love</span>
      <span>Rijin &amp; Twinkle · 2026</span>
    </footer>

    <script>
      const musicButton = document.querySelector<HTMLButtonElement>('.music-toggle');
      const music = document.querySelector<HTMLAudioElement>('#wedding-music');
      const musicLabel = document.querySelector<HTMLSpanElement>('.music-label');

      const syncMusicControl = (isPlaying: boolean) => {
        musicButton?.setAttribute('aria-pressed', String(isPlaying));
        musicButton?.setAttribute('aria-label', isPlaying ? 'Pause wedding music' : 'Play wedding music');
        if (musicLabel) musicLabel.textContent = isPlaying ? 'Pause music' : 'Play music';
      };

      if (music) {
        void music.play().then(() => syncMusicControl(true)).catch(() => syncMusicControl(false));
      }

      musicButton?.addEventListener('click', async () => {
        if (!music || !musicButton || !musicLabel) return;
        if (music.paused) {
          try {
            await music.play();
            syncMusicControl(true);
          } catch {
            musicLabel.textContent = 'Music unavailable';
          }
        } else {
          music.pause();
          syncMusicControl(false);
        }
      });
    </script>
  </body>
</html>