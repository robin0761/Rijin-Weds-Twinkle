---
import '../styles/invitation.css';

const churchMap = 'https://www.google.com/maps/dir/?api=1&destination=23.154402911396627%2C79.96616507482811';
const receptionMap = 'https://www.google.com/maps/dir/?api=1&destination=23.123976812537265%2C79.96574097482726';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eee9df" />
    <meta name="description" content="Join us to celebrate the wedding of Rijin and Twinkle on Thursday, November 12, 2026, in Jabalpur." />
    <title>Rijin &amp; Twinkle | Wedding Invitation</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <audio id="wedding-music" preload="none" loop>
      <source src="/media/wedding-music.mp3" type="audio/mpeg" />
    </audio>

    <div class="entry" id="entry" data-stage="intro">
      <img class="entry-image" src="/images/couple-real.webp" alt="" fetchpriority="high" />
      <div class="entry-shade"></div>
      <div class="entry-copy">
        <p class="entry-kicker">An invitation from</p>
        <p class="entry-names">Rijin <span>&amp;</span> Twinkle</p>
        <button class="entry-action" id="begin-invitation" type="button">
          <span class="entry-play" aria-hidden="true">▶</span>
          <span class="entry-action-label">Tap to play</span>
        </button>
      </div>
      <div class="envelope-stage" aria-hidden="true">
        <p class="envelope-kicker">You’ve got mail from</p>
        <p class="envelope-names">Rijin &amp; Twinkle</p>
        <button class="envelope" id="open-invitation" type="button" tabindex="-1" aria-label="Open wedding invitation">
          <span class="envelope-flap"></span>
          <span class="envelope-letter"><img src="/images/wedding-card-art.webp" alt="" /></span>
          <span class="envelope-seal">R<span>&amp;</span>T</span>
        </button>
        <p class="envelope-hint">Tap to open</p>
      </div>
    </div>

    <button class="music-toggle" type="button" aria-pressed="false" aria-label="Play wedding music">
      <span class="sound-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="music-label">Sound on</span>
    </button>

    <main class="invitation" id="invitation" inert aria-hidden="true">
      <section class="welcome" id="home" aria-labelledby="hero-title">
        <div class="welcome-inner">
          <p class="eyebrow">Together with our families</p>
          <h1 id="hero-title">Rijin <span>&amp;</span> Twinkle</h1>
          <p class="welcome-line">request the pleasure of your company</p>
          <figure class="card-art">
            <img src="/images/wedding-card-art.webp" alt="Illustrated wedding invitation artwork featuring Rijin and Twinkle" fetchpriority="high" />
          </figure>
          <a class="scroll-cue" href="#countdown">Scroll down <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <section class="countdown" id="countdown" aria-labelledby="countdown-title">
        <p class="eyebrow">Counting down to</p>
        <p class="countdown-date">12 November <span>2026</span></p>
        <h2 id="countdown-title">Our wedding day</h2>
        <div class="countdown-clock" aria-label="Countdown to the wedding">
          <div><strong id="days">--</strong><span>Days</span></div>
          <div><strong id="hours">--</strong><span>Hours</span></div>
          <div><strong id="minutes">--</strong><span>Minutes</span></div>
          <div><strong id="seconds">--</strong><span>Seconds</span></div>
        </div>
        <p class="countdown-note">A day we’ll remember forever</p>
        <div class="star-divider" aria-hidden="true"><span>✦</span><i></i><span>✧</span><i></i><span>✦</span></div>
      </section>

      <section class="events" id="venues" aria-label="Wedding events">
        <article class="event event-ceremony">
          <div class="event-photo"><img src="/images/photo-2.webp" alt="Rijin and Twinkle together" loading="lazy" /></div>
          <div class="event-copy">
            <p class="eyebrow">The sacred vows</p>
            <h2>Wedding ceremony</h2>
            <p class="event-description">Join us as we exchange vows and begin our forever.</p>
            <dl class="event-details">
              <div><dt>Date</dt><dd>Thursday, 12 November 2026</dd></div>
              <div><dt>Time</dt><dd>3:30 PM</dd></div>
              <div><dt>Place</dt><dd>St. Andrew’s Mar Thoma Church<br />Ridge Road, Jabalpur</dd></div>
            </dl>
            <a class="map-link" href={churchMap} target="_blank" rel="noreferrer">View on map <span aria-hidden="true">↗</span></a>
          </div>
        </article>

        <article class="event event-reception">
          <div class="event-photo"><img src="/images/photo-3.webp" alt="A happy moment from Rijin and Twinkle’s story" loading="lazy" /></div>
          <div class="event-copy">
            <p class="eyebrow">The celebration</p>
            <h2>Reception</h2>
            <p class="event-description">An evening of good company, warm wishes, and celebration.</p>
            <dl class="event-details">
              <div><dt>Date</dt><dd>Thursday, 12 November 2026</dd></div>
              <div><dt>Time</dt><dd>7:30 PM onwards</dd></div>
              <div><dt>Place</dt><dd>Vijan Mahal · Pool Side Lawn<br />Tilhari Manda Road, Jabalpur</dd></div>
            </dl>
            <a class="map-link" href={receptionMap} target="_blank" rel="noreferrer">View on map <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      </section>

      <section class="closing" aria-label="A note from the couple">
        <p class="eyebrow">With love and joy, we invite you</p>
        <p class="closing-names">Rijin <span>&amp;</span> Twinkle</p>
        <p class="closing-date">12 NOVEMBER 2026 <span>·</span> JABALPUR</p>
        <p class="closing-note">We can’t wait to celebrate with you.</p>
        <a class="back-to-top" href="#home">Back to the beginning ↑</a>
      </section>
    </main>

    <script>
      const musicButton = document.querySelector<HTMLButtonElement>('.music-toggle');
      const music = document.querySelector<HTMLAudioElement>('#wedding-music');
      const musicLabel = document.querySelector<HTMLSpanElement>('.music-label');
      const entry = document.querySelector<HTMLDivElement>('#entry');
      const envelopeStage = document.querySelector<HTMLDivElement>('.envelope-stage');
      const invitationLetter = document.querySelector<HTMLSpanElement>('.envelope-letter');
      const beginButton = document.querySelector<HTMLButtonElement>('#begin-invitation');
      const openButton = document.querySelector<HTMLButtonElement>('#open-invitation');
      const invitation = document.querySelector<HTMLElement>('#invitation');
      const entryActionLabel = document.querySelector<HTMLSpanElement>('.entry-action-label');

      const syncMusicControl = (isPlaying: boolean) => {
        musicButton?.setAttribute('aria-pressed', String(isPlaying));
        musicButton?.setAttribute('aria-label', isPlaying ? 'Pause wedding music' : 'Play wedding music');
        if (musicLabel) musicLabel.textContent = isPlaying ? 'Pause music' : 'Play music';
      };

      if (music) {
        void music.play().then(() => syncMusicControl(true)).catch(() => syncMusicControl(false));
      }

      const openEnvelope = () => {
        if (!entry || !invitation) return;
        if (entry.classList.contains('is-opening')) return;
        entry.classList.add('is-opening');
        invitation.removeAttribute('inert');
        invitation.setAttribute('aria-hidden', 'false');
        window.setTimeout(() => invitationLetter?.classList.add('is-rising'), 180);
        window.setTimeout(() => entry.classList.add('is-fading'), 1250);
        window.setTimeout(() => {
          entry.hidden = true;
          document.body.classList.remove('entry-active');
          window.scrollTo({ top: 0, behavior: 'instant' });
        }, 1980);
      };

      beginButton?.addEventListener('click', async () => {
        if (!entry) return;
        if (music?.paused) {
          try {
            await music.play();
            syncMusicControl(true);
          } catch {
            syncMusicControl(false);
          }
        }
        entry.dataset.stage = 'envelope';
        beginButton?.setAttribute('tabindex', '-1');
        envelopeStage?.removeAttribute('aria-hidden');
        entryActionLabel?.classList.add('is-hidden');
        openButton?.removeAttribute('tabindex');
        openButton?.focus();
      });

      openButton?.addEventListener('click', openEnvelope);
      document.body.classList.add('entry-active');

      const countdownTarget = new Date('2026-11-12T15:30:00+05:30').getTime();
      const updateCountdown = () => {
        const remaining = Math.max(0, countdownTarget - Date.now());
        const values = {
          days: Math.floor(remaining / 86_400_000),
          hours: Math.floor((remaining / 3_600_000) % 24),
          minutes: Math.floor((remaining / 60_000) % 60),
          seconds: Math.floor((remaining / 1_000) % 60),
        };
        for (const [unit, value] of Object.entries(values)) {
          const element = document.querySelector<HTMLElement>(`#${unit}`);
          if (element) element.textContent = String(value).padStart(2, '0');
        }
      };
      updateCountdown();
      window.setInterval(updateCountdown, 1000);

      musicButton?.addEventListener('click', async () => {
        if (!music || !musicButton || !musicLabel) return;
        if (music.paused) {
          try {
            await music.play();
            syncMusicControl(true);
          } catch {
            musicLabel.textContent = 'Music unavailable';
          }
        } else {
          music.pause();
          syncMusicControl(false);
        }
      });
    </script>
  </body>
</html>